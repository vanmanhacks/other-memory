# ───────────────────────────────────────────────────────────
# Other Memory — Environment Configuration
# ───────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit real secrets.
#
# Manual deployment (non-NixOS):
#   cp .env.example .env && chmod 600 .env
#
# On NixOS, other-memory.nix's other-memory-secret.service generates .env
# automatically at first boot.
# ───────────────────────────────────────────────────────────

# ─── Searxng ───────────────────────────────────────────────

# Random 32-byte hex secret for Searxng session tokens / CSRF.
# Generate your own:
#   openssl rand -hex 32
SEARXNG_SECRET=

# ─── Redis ─────────────────────────────────────────────────

# Password for the Redis cache — required by redis (--requirepass) and the
# MetaMCP bridge. Generate your own:
#   openssl rand -hex 16
REDIS_PASSWORD=

# ─── Optional overrides ─────────────────────────────────────

# Override service URLs if the stack runs on another host/port:
# SEARXNG_URL=http://localhost:8888
# CRAWL4AI_URL=http://localhost:11235
# REDIS_URL=redis://:<password>@localhost:6380/0

# ─── Ports Used (localhost only) ────────────────────────────
# Searxng:   127.0.0.1:8888
# Crawl4ai:  127.0.0.1:11235
# Redis:     127.0.0.1:6380
